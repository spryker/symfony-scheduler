{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Scheduled Tasks' %}

{% block head_title widget_title | trans %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: widget_title | trans } %}
        {% block widget_content %}
            {{ table | raw }}
        {% endblock %}
    {% endembed %}

    <script>
        (function () {
            var TABLE_ID = 'scheduler-job-table';
            var REFRESH_INTERVAL_MS = 5000;

            // Reload the table data in place so the job statuses stay live without a page reload.
            setInterval(function () {
                if (typeof $ === 'undefined' || !$.fn.dataTable) {
                    return;
                }

                var $table = $('#' + TABLE_ID);
                if ($table.length && $.fn.dataTable.isDataTable($table)) {
                    $table.DataTable().ajax.reload(null, false);
                }
            }, REFRESH_INTERVAL_MS);
        })();
    </script>
{% endblock %}
