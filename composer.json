{
    "name": "spryker/symfony-scheduler",
    "type": "library",
    "description": "SymfonyScheduler module",
    "license": "proprietary",
    "require": {
        "dragonmantank/cron-expression": "^3.0.0",
        "php": ">=8.3",
        "spryker/container": "^1.0.0",
        "spryker/gui": "^5.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/lock": "^1.1.0",
        "spryker/log": "^3.20.0",
        "spryker/monolog": "^2.0.0",
        "spryker/redis": "^2.13.0",
        "spryker/symfony": "^3.19.0",
        "spryker/symfony-messenger-extension": "^1.0.0",
        "spryker/symfony-scheduler-extension": "^1.0.0",
        "spryker/transfer": "^3.27.0",
        "spryker/util-text": "^1.1.0",
        "symfony/scheduler": "^6.4.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "suggest": {
        "ext-pcntl": "If you want to shutdown subprocesses on signal"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
